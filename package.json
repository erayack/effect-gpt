{
  "name": "effect-gpt",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare": "effect-language-service patch",
    "prepublishOnly": "bun run build",
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "bun --tsconfig-override tsconfig.dev.json src/cli/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/ts"
  },
  "dependencies": {
    "@effect/cli": "^0.74.0",
    "@effect/cluster": "^0.57.0",
    "@effect/experimental": "^0.59.0",
    "@effect/platform": "^0.95.0",
    "@effect/platform-bun": "^0.88.0",
    "@effect/rpc": "^0.74.0",
    "@effect/sql": "^0.50.0",
    "effect": "^3.20.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.80.0",
    "@types/bun": "latest",
    "effect-solutions": "^0.5.1",
    "typescript": "^5.6.0"
  }
}
