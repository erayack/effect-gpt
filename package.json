{
  "name": "effect-gpt",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "bun run build",
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "bun --tsconfig-override tsconfig.dev.json src/cli/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/ts"
  },
  "dependencies": {
    "effect": "^3.16.0",
    "@effect/platform": "^0.87.0",
    "@effect/platform-bun": "^0.60.22",
    "@effect/experimental": "^0.44.21",
    "@effect/sql": "^0.33.21"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
